# Evaluation artifacts are local by default. Only repository-authored,
# provenance-confirmed synthetic data is eligible for the initial public tree.
# The following paths remain on disk for local tests but are excluded from the
# initial public package until provenance/re-distribution review is complete.
evaluation/live/preflight/
evaluation/live/sessions/
evaluation/live/*real*.json
evaluation/30min/
evaluation/real-analyzer/
evaluation/golden/v2/
evaluation/context-spike/
evaluation/**/raw/
evaluation/**/audio/
evaluation/**/recordings/
evaluation/**/*.m4a
evaluation/**/*.wav
evaluation/**/*.mp3
evaluation/stt/
evaluation/runs/
evaluation/rescored/

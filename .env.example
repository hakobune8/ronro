# Copy this file to .env for local development. Never commit .env.
OPENAI_API_KEY=

# Non-secret pilot/runtime defaults.
REAL_ANALYZER_MODEL=gpt-5.6-luna
REAL_ANALYZER_REASONING_EFFORT=medium
OPENAI_REALTIME_STT_MODEL=gpt-transcribe
OPENAI_REALTIME_LANGUAGE=ja
PROMPT_VERSION=analyzer-prompt-v4
CONTEXT_VERSION=v1
NORMALIZATION_VERSION=v2
TYPE_D=OFF
PRESENTATION_COMPACTION=ON
OPEN_ITEM_LIFECYCLE=ON
LIVE_CONFIGURATION_VERSION=local

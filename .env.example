# Copy this file to .env for local development. Never commit .env.
OPENAI_API_KEY=

# Non-secret pilot/runtime defaults.
REAL_ANALYZER_MODEL=gpt-5.6-luna
REAL_ANALYZER_REASONING_EFFORT=medium
OPENAI_REALTIME_STT_MODEL=gpt-transcribe
OPENAI_REALTIME_LANGUAGE=ja
# Finalization controls. Keep the generic code default at `none`; the Pilot
# deployment selects `server_vad_bounded` explicitly after validation.
OPENAI_REALTIME_FINALIZATION_MODE=none
# OPENAI_REALTIME_PERIODIC_COMMIT_SECONDS=30
# OPENAI_REALTIME_VAD_THRESHOLD=0.5
# OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=300
# OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=500
# OPENAI_REALTIME_SEMANTIC_VAD_EAGERNESS=auto
PROMPT_VERSION=analyzer-prompt-v4
CONTEXT_VERSION=v1
NORMALIZATION_VERSION=v2
TYPE_D=OFF
PRESENTATION_COMPACTION=ON
OPEN_ITEM_LIFECYCLE=ON
LIVE_CONFIGURATION_VERSION=local
